{
  "version": 2,
  "routes": [
    {
      "src": "/(.*).js",
      "dest": "/$1.js",
      "headers": {
        "Content-Type": "application/javascript",
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/(.*).xml",
      "dest": "/$1.xml",
      "headers": {
        "Content-Type": "application/xml",
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
